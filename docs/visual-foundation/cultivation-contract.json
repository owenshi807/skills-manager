{
  "schema_version": "1.1.0",
  "id": "skill-equipment-cultivation",
  "status": "design_contract_not_runtime",
  "date": "2026-09-09",
  "authority": "Product-original visual semantics, informed by genre research; not a universal fictional canon.",
  "definition_document": "../skill-cultivation-visual-foundation-v1.md",
  "rating_authority": "../skill-rating-foundation-v1.md",
  "prompt_pack": "prompt-pack.md",
  "purpose": "Skill-review AI judges methods and evidence; the user's drawing Agent creates and evolves art within that conclusion. This is a reference prompt contract, not a runtime rating or award system.",
  "rating_compatibility": {
    "current_grades": [
      "C",
      "R",
      "SR"
    ],
    "achievement": "SSR",
    "achievement_permanent": true,
    "achievement_prerequisite_grade": null,
    "minimum_substantive_breakthroughs": 1,
    "visual_semantics_are_award_requirements": false,
    "unfinished_art_delays_or_revokes_achievement": false,
    "current_evidence_is_separate": true,
    "unverified_means_low_ability": false,
    "stale_current_evidence_revokes_achievement": false,
    "award_personal_profile": false,
    "award_entire_library": false,
    "combination_members_auto_inherit": false,
    "hide_unearned_achievement": true,
    "future_grade_slots": [],
    "examples_are_awards": false,
    "same_grade_visual_evolution": true,
    "visual_redraw_requires_new_breakthrough": false,
    "visual_redraw_repeats_award": false,
    "visual_revision_changes_current_grade": false,
    "content_revision_may_need_current_assessment": true,
    "visual_personalization_implies_personal_mastery": false
  },
  "independent_axes": [
    "visual_grade",
    "equipment_family",
    "element_motif",
    "art_style",
    "artifact_spirit_mode",
    "domain_inhabitants",
    "domain_links"
  ],
  "element_motifs": [
    "earth",
    "water",
    "wood",
    "fire",
    "light",
    "cosmos",
    "life"
  ],
  "art_styles": [
    "adventure_field_guide",
    "eastern_mythic_nature",
    "mechanical_expedition",
    "mineral_print"
  ],
  "default_art_style": "adventure_field_guide",
  "global_rules": {
    "separate_artwork_per_grade": true,
    "preserve_family_identity": true,
    "silhouette_distinct_without_effects": true,
    "low_grade_is_complete_not_damaged": true,
    "text_baked_into_generated_art": false,
    "text_foil_allowed": false,
    "ip_specific_characters_logos_or_signature_weapons": false,
    "foil_is_added_by_renderer_not_painted_as_overlay": true,
    "all_grades_support_card_thickness": true,
    "layered_illustration_is_volumetric_equipment": false,
    "static_simplified_asset_allowed": true,
    "all_four_grades_required_before_drawing": false,
    "same_grade_art_can_simplify": true,
    "preserve_achievement_origin": true,
    "per_grade_structure_is_guidance_not_award_gate": true
  },
  "interaction": {
    "hover": "small_pointer_position_tilt",
    "pointer_leave": "settle_to_neutral",
    "click": "flip_front_back",
    "keyboard": [
      "Enter_flip",
      "Space_flip"
    ],
    "separate_back_action_button": false,
    "automatic_card_rotation": false,
    "automatic_whole_card_flash": false,
    "automatic_foil_sweep": false,
    "max_active_inspection_cards": 1,
    "pause_local_motion_when": [
      "user_paused",
      "prefers_reduced_motion",
      "back_visible",
      "offscreen",
      "document_hidden"
    ],
    "static_grade_identity_required": true
  },
  "grades": [

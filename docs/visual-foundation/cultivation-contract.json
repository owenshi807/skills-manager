      "record_kind": "permanent_breakthrough_achievement",
      "motto": "成域",
      "meaning": "一次已成立的 Skill 方法突破化为独有领域；取得圣品后继续个性化演变，不要求再突破或升级品阶。",
      "world_relation": "artifact_and_domain_share_a_personalized_relationship",
      "background": "simple_or_expansive_domain_with_optional_habitat_and_inhabitants",
      "effects": {
        "foil_scope": "full_card_excluding_text",
        "rainbow_edge": true,
        "gold_card_trim": "engraved",
        "emissive_channels": "core_masked",
        "ordinary_material_reflection": true,
        "parallax": "core_object_domain_layers",
        "idle_motion": "optional_slow_local_motion_or_occasional_inhabitant_appearance",
        "core_cycle_seconds_reference": [
          8,
          14
        ],
        "domain_cycle_seconds_reference": [
          20,
          35
        ],
        "foil_time_driven": false,
        "whole_card_luminance_pulse": false,
        "artifact_spirit_motion_boundaries": {
          "abstract_core_soul": "core_mask",
          "attached_companion": "declared_attachment_region"
        },
        "external_inhabitant_motion": "independent_layer_path_and_occlusion_not_core_mask",
        "static_reduced_motion_pose": "readable_natural_pose_showing_domain_relationship"
      },
      "reject": [
        "mandatory_cosmos_or_soul",
        "brightness_as_only_upgrade",
        "visual_domain_as_new_award_gate",
        "visual_redraw_resets_achievement"
      ],
      "structural_guidance": [
        "recognizable_equipment_identity",
        "one_expressive_domain_relation_as_start",
        "achievement_marker_preserved",
        "optional_richer_structure_or_ecosystem"
      ],
      "reference_elements": [
        "earth",
        "water",
        "wood",
        "fire",
        "light",
        "cosmos",
        "life"
      ],
      "custom_elements_allowed": true,
      "artifact_spirit_modes": [
        "none",
        "abstract_core_soul",
        "attached_companion"
      ],
      "domain_inhabitants": "optional_static_or_locally_animated_domain_beings"
    }
  ],
  "layer_contract": {
    "subject": "independent_equipment_RGBA_true_alpha",
    "background": "separate_environment_without_duplicate_equipment_may_include_selected_static_inhabitants",
    "lineart": "pixel_registered_to_subject",
    "foil_mask": "empty_for_C_R_equipment_only_for_SR_text_excluded_for_all",
    "text": "deterministic_typesetting_separate_from_art",
    "optional_layers": {
      "core_mask": "required_when_core_motion_is_used",
      "domain_depth_layers": "required_when_domain_parallax_is_used",
      "breakthrough_emblem": "separate_typeset_or_graphic_achievement_marker_can_be_added_after_art",
      "artifact_spirit_layer": "when_artifact_spirit_motion_is_requested_use_core_mask_or_attachment_region",
      "external_inhabitant_layer": "when_being_motion_is_requested_use_own_habitat_path_depth_and_occlusion"
    },
    "alpha_fallback": "uniform_white_for_explicit_technical_cutout_never_painted_checkerboard",
    "applies_when": "layered_or_animated_export_requested_static_concept_does_not_require_all_layers"
  },
  "generation_sequence": [
    "skill_review_conclusion",
    "user_idea_and_optional_previous_art",
    "equipment_identity",
    "grade_semantics",
    "one_domain_idea",
    "complete_static_art",
    "optional_layers_and_motion",
    "same_grade_visual_evolution"
  ],
